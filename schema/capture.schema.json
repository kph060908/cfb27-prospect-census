{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kph060908/cfb27-prospect-census/schema/capture.schema.json",
  "title": "capture.json (cfb27-prospect-census/1)",
  "type": "object",
  "required": ["format", "league", "team", "platform", "capture_mode", "season", "class_year", "stage", "captured_on",
               "counters_open", "counters_close", "class_size", "counts", "lists", "checks", "known_gaps", "tool"],
  "properties": {
    "format": {"const": "cfb27-prospect-census/1"},
    "league": {"type": "string", "minLength": 1},
    "league_as_shown": {"type": ["string", "null"]},
    "team": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "capture_mode": {"type": ["string", "null"]},
    "season": {"type": "integer"},
    "class_year": {"type": "integer"},
    "stage": {"type": "string", "minLength": 1},
    "captured_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "counters_open": {"$ref": "#/$defs/counters"},
    "counters_close": {"$ref": "#/$defs/counters"},
    "class_size": {"type": "integer", "minimum": 1},
    "counts": {
      "type": "object",
      "required": ["recruits", "card_reads", "reads_with_errors", "records_with_fixes"],
      "properties": {
        "recruits": {"type": "integer"}, "card_reads": {"type": "integer"},
        "reads_with_errors": {"type": "integer"}, "records_with_fixes": {"type": "integer"}
      }
    },
    "lists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["list", "recruits", "max_position_rank"],
        "properties": {"list": {"type": "string"}, "recruits": {"type": "integer"}, "max_position_rank": {"type": "integer"}}
      }
    },
    "checks": {"type": "object", "additionalProperties": {"enum": ["PASS", "WARN", "FAIL"]}},
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
    }
  },
  "$defs": {
    "counters": {
      "type": "object",
      "required": ["remaining", "targets", "hours", "scholarships"],
      "properties": {
        "remaining": {"type": ["string", "integer"]}, "targets": {"type": ["string", "integer"]},
        "hours": {"type": ["string", "integer"]}, "scholarships": {"type": ["string", "integer"]}
      }
    }
  }
}
